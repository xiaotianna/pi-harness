{
  "name": "pi-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pi-harness/daemon --filter @pi-harness/web dev",
    "dev:daemon": "pnpm --filter @pi-harness/daemon dev",
    "dev:oauth": "emulate --seed emulate.config.yaml",
    "dev:web": "pnpm --filter @pi-harness/web dev",
    "env:check": "node scripts/env-crypto.mjs check",
    "env:decrypt": "node scripts/env-crypto.mjs decrypt",
    "env:encrypt": "node scripts/env-crypto.mjs encrypt",
    "env:key:copy": "node scripts/env-crypto.mjs copy-key",
    "env:key:store": "node scripts/env-crypto.mjs store-key",
    "eval:context": "pnpm --filter @pi-harness/evals eval:context",
    "eval:context:live": "pnpm --filter @pi-harness/evals eval:context:live",
    "dev:docker": "docker compose -f docker-compose.dev.yml up -d",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "emulate": "catalog:",
    "typescript": "catalog:"
  }
}
