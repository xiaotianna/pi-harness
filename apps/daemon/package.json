{
  "name": "@pi-harness/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "PI_HARNESS_DATABASE_PATH=../../.pi-harness/harness.sqlite tsx watch --env-file-if-exists=../../.env src/bootstrap.ts",
    "start": "node --env-file-if-exists=../../.env dist/bootstrap.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "catalog:",
    "@pi-harness/providers": "workspace:*",
    "fastify": "catalog:",
    "pino": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
