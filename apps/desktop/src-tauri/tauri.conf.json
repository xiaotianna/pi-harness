{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PI Harness",
  "version": "0.0.0",
  "identifier": "com.piharness.desktop",
  "build": {
    "beforeDevCommand": "node scripts/dev.mjs",
    "beforeBuildCommand": "pnpm prepare:bundle",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PI Harness",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true
  }
}
